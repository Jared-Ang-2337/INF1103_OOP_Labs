classDiagram
direction LR
class Product {
  <<abstract>>
  -productid: int
  -name: str
  -price: float
  -stock: int
  -supplier: Supplier
  +update_stock(quantity: int) None
  +display_information() None
  +get_fulfilment_info() str*
}
class PhysicalProduct {
  -weight: float
  +calculate_shipping_cost() float
}
class DigitalProduct {
  -size: float
}
class CanBeShipped {
  <<interface>>
  +calculate_shipping_cost() float
}
class Supplier {
  +supplier_id: str
  +name: str
  +contact_email: str
  +display_information() str
}
class Inventory {
  -products: Product[0..*]
  +add_product(product: Product) None
  +remove_product(product_id: int) Product | None
  +find_product(product_id: int) Product | None
}
class Order {
  +order_id: str
  +order_lines: OrderLine[0..*]
  +add_order_line(product: Product, quantity: int) None
  +calculate_total() float
}
class OrderLine {
  +product: Product
  +quantity: int
  +calculate_subtotal() float
}
Product <|-- PhysicalProduct
Product <|-- DigitalProduct
CanBeShipped <|.. PhysicalProduct
Supplier "1" --> "0..*" Product : supplies
Inventory "0..1" o-- "0..*" Product : contains
Order "1" *-- "0..*" OrderLine : composed of
OrderLine "0..*" --> "1" Product : refers to
